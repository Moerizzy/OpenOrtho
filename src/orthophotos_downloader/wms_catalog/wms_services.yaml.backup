# WMS Catalog for German Orthophotos
# This catalog contains WMS service definitions for downloading orthophotos
# Organized by state, year, and image type
#
# Structure:
# - services: List of WMS service definitions
#   - id: Unique identifier (state_type_resolution_year)
#   - state_code: Two-letter state code (BW, BY, etc.)
#   - state_name: Full state name
#   - type: Image type (RGB or CIR)
#   - resolution: Resolution in meters (0.2, 0.4, etc.)
#   - year: Year or year range for the imagery
#   - url: WMS service URL
#   - version: WMS version (1.1.1 or 1.3.0)
#   - layer_name: WMS layer name
#   - crs: Coordinate reference system (EPSG:25832, etc.)
#   - format: Image format (image/png, image/tiff, etc.)
#   - availability: Coverage information (state-wide, partial, etc.)
#   - temporal_coverage: Time period covered
#   - description: Human-readable description
#   - direct_download: Whether direct tile download is available
#   - tile_url_pattern: URL pattern for direct downloads (if available)
#   - source: Source organization/agency

version: "1.0"
last_updated: "2025-10-29"

services:
  # Baden-Württemberg (BW)
  - id: BW_RGB_DOP20_current
    state_code: BW
    state_name: Baden-Württemberg
    type: RGB
    resolution: 0.2
    year: latest
    temporal_coverage: "2020-current"
    url: "https://owsproxy.lgl-bw.de/owsproxy/ows/WMS_LGL-BW_ATKIS_DOP_20_C?"
    version: "1.1.1"
    layer_name: IMAGES_DOP_20_RGB
    crs: EPSG:25832
    format: image/png
    availability: state-wide
    description: "Baden-Württemberg DOP20 RGB - Latest imagery"
    direct_download: false
    source: "LGL Baden-Württemberg"
    
  - id: BW_CIR_DOP20_current
    state_code: BW
    state_name: Baden-Württemberg
    type: CIR
    resolution: 0.2
    year: latest
    temporal_coverage: "2020-current"
    url: "https://owsproxy.lgl-bw.de/owsproxy/ows/WMS_LGL-BW_ATKIS_DOP_20_CIR"
    version: "1.1.1"
    layer_name: IMAGES_DOP_20_CIR
    crs: EPSG:25832
    format: image/png
    availability: state-wide
    description: "Baden-Württemberg DOP20 CIR - Latest imagery"
    direct_download: false
    source: "LGL Baden-Württemberg"

  # Bayern (BY)
  - id: BY_RGB_DOP20_current
    state_code: BY
    state_name: Bayern
    type: RGB
    resolution: 0.2
    year: latest
    temporal_coverage: "2020-current"
    url: "https://geoservices.bayern.de/od/wms/dop/v1/dop20?"
    version: "1.1.1"
    layer_name: by_dop20c
    crs: EPSG:25832
    format: image/tiff
    availability: state-wide
    description: "Bayern DOP20 RGB - Latest imagery"
    direct_download: true
    tile_url_pattern: "https://geoservices.bayern.de/od/wms/dop/v1/dop20?SERVICE=WMS&REQUEST=GetMap&LAYERS=by_dop20c&STYLES=&FORMAT=image/tiff&TRANSPARENT=false&VERSION=1.1.1&WIDTH={width}&HEIGHT={height}&SRS=EPSG:25832&BBOX={bbox}"
    source: "Bayerische Vermessungsverwaltung"
    
